# Merge these non-secret settings into the existing local/VPS .env.
# Do not replace API keys, Telegram credentials, symbols, or strategy settings.

# Fill reconciliation and execution telemetry
EXECUTION_RECONCILIATION_ENABLED=True
EXECUTION_VERIFY_ATTEMPTS=4
EXECUTION_VERIFY_DELAY_SECONDS=0.25
EXECUTION_RESIDUAL_RETRY_ATTEMPTS=1
EXECUTION_TELEMETRY_ENABLED=True
EXECUTION_TELEMETRY_PATH=data/execution_telemetry_v6.csv
EXECUTION_TELEMETRY_QUEUE_SIZE=2000
STATE_UPSERT_RETRY_ATTEMPTS=3
STATE_UPSERT_RETRY_DELAY_SECONDS=0.25
REQUIRE_STATE_FOR_OPEN_POSITIONS=True
PROTECTION_FAILURE_CLOSE_ENABLED=True
REQUIRE_ONE_WAY_POSITION_MODE=True

# Smart IOC execution with a terminal-only market fallback
SMART_EXECUTION_ENABLED=True
SMART_EXECUTION_TIME_IN_FORCE=IOC
SMART_EXECUTION_MAX_CROSS_BPS=2
SMART_EXECUTION_BOOK_TICKER_WEIGHT=2
SMART_EXECUTION_MARKET_FALLBACK_ENABLED=True
SMART_EXECUTION_CONTEXTS=ENTRY,DCA

# Existing market-flow behavior remains unchanged
MARKET_FLOW_RANK_WEIGHT=1
MARKET_FLOW_HARD_VETO_ENABLED=False

# Footprint, CVD, and retained top-1000 depth observation only
ORDER_FLOW_SHADOW_ENABLED=True
ORDER_FLOW_SHADOW_MAX_SYMBOLS=12
ORDER_FLOW_SHADOW_SYMBOLS=
ORDER_FLOW_SHADOW_DEPTH_STREAMS_PER_SOCKET=12
ORDER_FLOW_SHADOW_DEPTH_UPDATE_MS=250
ORDER_FLOW_SHADOW_DEPTH_SNAPSHOT_LIMIT=1000
ORDER_FLOW_SHADOW_CORE_WEIGHT_RESERVE=500
ORDER_FLOW_SHADOW_SNAPSHOT_RETRY_SECONDS=10
ORDER_FLOW_SHADOW_QUEUE_SIZE=20000
ORDER_FLOW_SHADOW_MAX_TRADES_PER_SYMBOL=50000
ORDER_FLOW_SHADOW_WINDOW_SECONDS=300
ORDER_FLOW_SHADOW_BUCKET_BPS=1
ORDER_FLOW_SHADOW_MIN_BUCKET_NOTIONAL=5000
ORDER_FLOW_SHADOW_IMBALANCE_RATIO=3
ORDER_FLOW_SHADOW_STALE_SECONDS=15
ORDER_FLOW_SHADOW_IMPACT_NOTIONAL_USDT=10000
ORDER_FLOW_SHADOW_TELEMETRY_ENABLED=True
ORDER_FLOW_SHADOW_TELEMETRY_PATH=data/order_flow_shadow_v6.csv
ORDER_FLOW_SHADOW_TELEMETRY_MIN_INTERVAL_SECONDS=30

# TP1 75% -> protected runner -> TP2
MULTI_TP_ENABLED=True
TP1_CLOSE_POSITION_PCT=75
TP1_MAX_CLOSE_PCT_DEVIATION=5
TP2_FALLBACK_ROI=50
TP1_RUNNER_STOP_ENABLED=True
TP1_RUNNER_RETRY_SECONDS=5
TP1_HEALTH_CHECK_SECONDS=60
TP1_RUNNER_DISABLE_DCA=True

# V6 fixed-risk campaign sizing and immutable hard stop
# MARGIN_PER_TRADE remains the maximum margin for the whole campaign.
TREND_SL_ENABLED=True
REVERSAL_SL_ENABLED=True
TREND_MAX_SL_ROI=40
REVERSAL_MAX_SL_ROI=80
SL_INVALID_FAILS_PROTECTION_ORDER=True
RISK_BASED_POSITION_SIZING_ENABLED=True
POSITION_RISK_PCT=0.5
POSITION_RISK_MAX_USDT=0
POSITION_RISK_OVERRUN_TOLERANCE_PCT=2
POSITION_MANAGEMENT_LEGACY_ENABLED=False

# One 70/30 fixed-risk recovery add; V6 keeps its own strategy/live frames.
DCA_MANAGE_EXISTING_POSITIONS=False
DCA_MAX_ORDERS=1
DCA_INITIAL_MARGIN_PCT=70
DCA_MARGIN_PCTS=30
DCA_INITIAL_RISK_PCT=70
DCA_RECOVERY_RISK_PCT=30
DCA_TRIGGER_ROIS=25
DCA_MAX_ADVERSE_ROI=35
DCA_MIN_SECONDS_BETWEEN_ORDERS=3600
DCA_MIN_PRICE_GAP_ROI=8
DCA_REPRICE_TP_AFTER_FILL=True
DCA_FIXED_RISK_ENABLED=True
DCA_REQUIRE_HARD_STOP=True
DCA_MIN_HARD_STOP_BUFFER_ROI=5
DCA_RECOVERY_CONFIRMATION_ENABLED=True
DCA_RECOVERY_TREND_ONLY=True
DCA_RECOVERY_REQUIRE_DATA=True
DCA_RECOVERY_REQUIRE_BOTH_TIMEFRAMES=True
DCA_RECOVERY_MIN_REBOUND_ROI=8
DCA_RECOVERY_ARM_TIMEOUT_MINUTES=240
DCA_RECOVERY_EXTREME_PERSIST_STEP_ROI=1
LIVE_ENTRY_FAST_TIMEFRAME=5m
LIVE_ENTRY_SLOW_TIMEFRAME=15m

# Coordinated trend exits. Reversal time/early exits stay opt-in.
EARLY_FLOW_EXIT_ENABLED=True
EARLY_FLOW_EXIT_TREND_ENABLED=True
EARLY_FLOW_EXIT_REVERSAL_ENABLED=False
EARLY_FLOW_EXIT_MINUTES=15
EARLY_FLOW_EXIT_POST_DCA_GRACE_MINUTES=15
EARLY_FLOW_EXIT_TREND_MAX_ROI=-20
EARLY_FLOW_EXIT_REVERSAL_MAX_ROI=-12
EARLY_FLOW_EXIT_CHECK_SECONDS=60
EARLY_FLOW_EXIT_REQUIRE_DATA=True
TIME_EXIT_ENABLED=True
TIME_EXIT_TREND_ENABLED=True
TIME_EXIT_REVERSAL_ENABLED=False
TIME_EXIT_MINUTES=240
TIME_EXIT_MAX_ROI=0
TIME_EXIT_CHECK_SECONDS=60
TIME_EXIT_PENDING_RETRY_SECONDS=60
TIME_EXIT_POST_DCA_GRACE_MINUTES=30
TIME_EXIT_REQUIRE_WEAKNESS=True
TIME_EXIT_REQUIRE_DATA=True
TIME_EXIT_MIN_WEAKNESS_SCORE=2

# Crash/restart reconciliation and stop repair
PENDING_EXECUTION_RECONCILE_SECONDS=5
UNTRACKED_POSITION_FAIL_CLOSE_ENABLED=False
PROFIT_EXIT_PENDING_RETRY_SECONDS=60
HARD_STOP_RECONCILE_ENABLED=True
HARD_STOP_RECONCILE_LEGACY_POSITIONS=False
HARD_STOP_STARTUP_FAIL_CLOSE=True

# Host-local runtime state; preserve this file during the first VPS upgrade.
DCA_STATE_PATH=data/open_trades_v6.json
